# Copy to .env and edit. Every value below has a working default — the stack
# boots with no .env at all, on SQLite, with no model calls.

# ---- app ------------------------------------------------------------------
# Setting this to `production` makes the app refuse to start unless SECRET_KEY
# is a real value of at least 32 characters.
JUICEBOX_ENV=development
BASE_URL=http://localhost:8000
# Generate for production:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me-in-production
ACCESS_TOKEN_TTL_SECONDS=43200
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- OpenInstinct candidate bridge ----------------------------------------
# Candidate chat, Linq, vault, and Kernel browser execution live in the
# separate OpenInstinct deployment. These values configure only short-lived
# signed service calls; never put candidate ATS passwords in this file.
OPENINSTINCT_URL=
OPENINSTINCT_SHARED_SECRET=
OPENINSTINCT_REQUEST_TIMEOUT_SECONDS=8
# PBKDF2-HMAC-SHA256 rounds. 240000 is the default; production and staging
# refuse to boot below that. Tests set 1000 so signup isn't the suite bottleneck.
# verify_password reads the round count out of the stored hash, so mixed-cost
# hashes keep working.
# JUICEBOX_PBKDF2_ROUNDS=240000

# ---- storage --------------------------------------------------------------
# SQLite (default, zero setup):
# DATABASE_URL=sqlite:///./data/juicebox.db
# PostgreSQL (docker compose):
# DATABASE_URL=postgresql+psycopg://juicebox:juicebox@localhost:5432/juicebox

# ---- model ----------------------------------------------------------------
# Without a key the product still works end to end: the heuristic parser,
# deterministic scoring and template personalisation all run offline.
ANTHROPIC_API_KEY=
JUICEBOX_LLM_ENABLED=true
JUICEBOX_LLM_MODEL=claude-opus-5
LLM_MAX_CONCURRENCY=8
# Retries apply to 429s and 5xx only; refusals and bad JSON are not retried.
LLM_MAX_RETRIES=2
LLM_RETRY_INITIAL_DELAY=0.5
LLM_RETRY_MAX_DELAY=8.0

# ---- embeddings -----------------------------------------------------------
# hashing = offline + deterministic. voyage = hosted, needs VOYAGE_API_KEY.
EMBEDDING_PROVIDER=hashing
EMBEDDING_DIM=512
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3
# auto = postgres FTS+pgvector when DATABASE_URL is postgres, else in-process.
# memory forces the RAM index even on postgres (debugging / parity checks).
RETRIEVAL_BACKEND=auto

# ---- retrieval tuning -----------------------------------------------------
RETRIEVAL_CANDIDATE_POOL=200
RERANK_TOP_K=20
RRF_K=60
# Blend of the three signals in the final score (normalised automatically).
HEURISTIC_WEIGHT=0.55
RETRIEVAL_WEIGHT=0.20
RERANK_WEIGHT=0.25

# ---- outreach -------------------------------------------------------------
# console | smtp | memory
EMAIL_PROVIDER=console
OUTREACH_FROM_EMAIL=recruiting@example.com
OUTREACH_FROM_NAME=Talent Team
OUTREACH_DAILY_CAP=200
# Gap between two automated emails from the same mailbox, picked in [MIN, MAX] seconds (MIN=0 = no gap).
OUTREACH_SEND_SPACING_SECONDS=45
OUTREACH_SEND_SPACING_MAX_SECONDS=60
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# ---- integrations: Outlook via Microsoft Graph ------------------------------
# Azure app registration (single-tenant). Leave empty to disable the feature.
# Redirect URI defaults to {BASE_URL}/v1/integrations/microsoft/callback and
# must match the URI registered on the Azure app.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=organizations
MS_REDIRECT_URI=
# ---- integrations: Zoho Mail ------------------------------------------------
# A "server-based" OAuth client from api-console.zoho.com. Leave empty to
# disable. Turn on Multi DC if any mailbox lives outside the accounts domain
# below; the callback then reports which data centre each mailbox belongs to.
# Redirect URI defaults to {BASE_URL}/v1/integrations/zoho/callback and must
# match the client exactly. Scopes needed: ZohoMail.accounts.READ,
# ZohoMail.messages.ALL, ZohoMail.folders.READ.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=
# The data centre the mailboxes live in: accounts.zoho.com / .eu / .in /
# .com.au / .jp / zohocloud.ca / .sa
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com

# ---- candidate connectors (Gmail / Outlook / GitHub) -------------------------
# Candidate-side "connect your apps" OAuth. Deliberately separate credentials
# from the recruiter mailboxes above and the portal sign-in below: these
# grants are read-only and thread-scoped. Empty client id = that app is never
# offered in the intake conversation.
#
# Gmail needs an OAuth client (Web application) with the gmail.readonly scope.
# That is a Google RESTRICTED scope: publishing past Testing mode requires app
# verification plus an annual CASA assessment (see INTAKE_COMPLIANCE.md,
# "Connected apps"). Testing mode (<=100 test users) is fine for the pilot;
# note its refresh tokens expire after 7 days, so a later re-index may need a
# reconnect. Redirect defaults to {BASE_URL}/v1/connect/google/callback.
GOOGLE_CONNECT_CLIENT_ID=
GOOGLE_CONNECT_CLIENT_SECRET=
GOOGLE_CONNECT_REDIRECT_URI=
# Its own Azure app registration with PERSONAL accounts allowed
# (signInAudience=AzureADandPersonalMicrosoftAccount) -- candidates hold
# outlook.com addresses, which the recruiter-side app's `organizations`
# tenant rejects. Scopes: offline_access User.Read Mail.Read (read-only).
# Redirect defaults to {BASE_URL}/v1/connect/microsoft/callback.
MS_CANDIDATE_CLIENT_ID=
MS_CANDIDATE_CLIENT_SECRET=
MS_CANDIDATE_TENANT_ID=common
MS_CANDIDATE_REDIRECT_URI=
# A GitHub OAuth *app* (not the GITHUB_TOKEN PAT sourcing uses). Scope:
# read:user. Redirect defaults to {BASE_URL}/v1/connect/github/callback.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=
# Dev only: register the scripted FakeConnector so the connect flow can be
# demoed with no OAuth apps. Never set in production.
JUICEBOX_FAKE_CONNECTOR=false

# ---- mailbox sync (any provider) -------------------------------------------
# How often the worker checks each connected inbox for candidate replies. The
# dispatcher spreads one job per mailbox across this interval.
MAILBOX_SYNC_SECONDS=120

# The model for work someone is waiting on -- previews, personalisation. Left
# empty it falls back to JUICEBOX_LLM_MODEL, so only the timeout changes.
#
# Worth setting. Measured against production's reasoning model on the real
# personalisation prompt: z-ai/glm-5.2 took 74s and then returned non-JSON, so
# the call failed and the heuristic text was used anyway;
# google/gemini-2.5-flash-lite answered in 3.3s with valid output. Note that
# openai/gpt-4o-mini 404s here -- the JSON-schema request pins routing to
# providers that also accept a reasoning budget, and it is not one of them.
JUICEBOX_LLM_FAST_MODEL=
# How long a fast call may take before falling back to the deterministic text.
LLM_FAST_TIMEOUT_SECONDS=20


# ---- integrations: ContactOut (personal-email enrichment) --------------------
# Personal email addresses for LinkedIn-sourced candidates, keyed on the profile
# URL. Measured 7/10 personal addresses against Apollo's 1/10 on the same ten
# candidates; billed per address found, so a miss is free. API access is on
# ContactOut's Team/API plan. Leave empty to disable the provider.
CONTACTOUT_API_KEY=

# ---- worker ---------------------------------------------------------------
WORKER_TICK_SECONDS=60
WORKER_POLL_SECONDS=2
WORKER_BATCH_SIZE=20
WORKER_LOCK_TIMEOUT_SECONDS=900
WORKER_MAX_ATTEMPTS=5

# ---- ingestion worker -----------------------------------------------------
JUICEBOX_API_URL=http://localhost:8000
JUICEBOX_API_KEY=
INGEST_BATCH_SIZE=200
INGEST_CONCURRENCY=3
INGEST_WEBHOOK_PORT=8787
INGEST_WEBHOOK_SECRET=
# Local-only: accept unsigned webhooks even when JUICEBOX_API_KEY is set.
# Production must set INGEST_WEBHOOK_SECRET instead; an empty secret with a
# live API key is an open write.
# INGEST_ALLOW_UNSIGNED=1
GITHUB_TOKEN=

# ---- job matching / Exa ---------------------------------------------------
# Worker scrapes public job postings on a cadence. Empty = skip cleanly; the
# jobs database still works off Project sync and CSV import.
EXA_API_KEY=
# JOB_MATCH_MIN_SCORE=0.55
# JOB_POSTING_STALE_DAYS=21
# JOB_REMATCH_NOT_NOW_DAYS=90
# JOB_MATCH_REFRESH_HOURS=24
# JOB_SCRAPE_MAX_AUTO_QUERIES=5

# ---- foray sourcing engine (packages/foray) -------------------------------
# Foray shares this .env but namespaces its DB URL so it never clobbers the
# Juicebox DATABASE_URL above. Points at the `foray` database created inside the
# shared pgvector Postgres container (see docker-compose.yml + packages/foray).
FORAY_DATABASE_URL=postgresql://foray:foray@localhost:5432/foray
# GITHUB_TOKEN (above) is reused by Foray for harvest + enrichment (classic PAT,
# no scopes needed for public data). ANTHROPIC_API_KEY (above) powers scoring.
# Apollo is Phase 6 only; leave blank until then. Use a personal account.
APOLLO_API_KEY=
# Optional overrides (all have working defaults):
# FORAY_SCORING_MODEL=claude-haiku-4-5-20251001
# FORAY_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# FORAY_RETRIEVAL_ARMS=vector,lexical   # score = legacy top-N-by-archetype rollback
# FORAY_W_RRF=0.5
# FORAY_W_SCORE=0.3
# FORAY_W_VECTOR=0.2
# FORAY_UNSCORED_SCORE=20              # with RERANK_ENABLED; 0 sinks unscored rows
# FORAY_RERANK_ENABLED=true            # prod compose default; keep false in CI / bare uvicorn
# FORAY_MAX_PAGINABLE=1000
# FORAY_MIN_REACH_SCORE=0            # send-floor; 0 = off until measured
# FORAY_NAME_BRIDGE_MIN_COMMITS=3    # rarity corroboration for LinkedIn name-bridge

# --- Foray internal calls (server to server) ---------------------------------
# Foray's /internal/* routes spend money (ContactOut credits) and /foray/* is
# proxied to the browser with no authentication at all, so those routes are
# gated by a shared secret that only the api container holds. Leave it blank and
# the "Find emails" action reports itself unavailable rather than failing oddly.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
FORAY_INTERNAL_TOKEN=
# Where the api container reaches Foray. The compose default is the service name.
FORAY_BASE_URL=http://localhost:8100

# --- auto-apply (Phase F) -----------------------------------------------------
# Whether anything is ever submitted to a real employer, and the default cannot
# reach one:
#   console  log the application we would have sent; the whole path runs, the
#            attempt row is written, nothing leaves the machine. Default.
#   memory   the test double.
#   live     vendor adapters actually run. This is the deliberate act.
APPLY_SUBMITTER=console

# The mailbox that owns every candidate alias, sub-addressed per candidate as
# anna+<token>@goforay.io. It must be a real mailbox we can BOTH send from and
# read: an ATS emails a verification link or a one-time code to whatever address
# went on the application, and reading it is how that loop closes without a
# human. Connect it as a mailbox connection too (Settings -> Mailboxes) or
# nothing inbound is ever seen.
#
# Leaving this empty is a supported state, not a broken one: the candidate's own
# address goes on the application, and every portal that gates on email
# verification then stalls. Workday and Oracle both do.
APPLY_ALIAS_ADDRESS=anna@goforay.io
# Forward employer mail that arrives at an alias on to the candidate's real
# inbox. false keeps it in the portal only.
APPLY_ALIAS_RELAY=true
# Attempts per application before it stops and waits for a person.
APPLY_MAX_ATTEMPTS=3
# A visible browser is for debugging one run by hand, never for the worker.
APPLY_BROWSER_HEADLESS=true

# Browser Use Cloud. Empty key = public boards hand off. The agent also needs
# APPLY_BROWSER_AGENT=true and APPLY_BROWSER_AGENT_ACK=true (screenshots,
# resume bytes, and profile state go to Browser Use + the vision model).
BROWSER_USE_API_KEY=
APPLY_BROWSER_AGENT=false
APPLY_BROWSER_AGENT_ACK=false
APPLY_BROWSER_AGENT_TIMEOUT_MIN=15
APPLY_BROWSER_AGENT_MAX_STEPS=40
APPLY_BROWSER_PROXY_COUNTRY=us

# How long a browser run may wait on a verification email before it stops being
# "in flight" and becomes something a person has to look at.
APPLY_VERIFICATION_HOURS=24

# There is deliberately no ATS API key here. Greenhouse, Lever and Ashby each
# authenticate with a key the EMPLOYER generates in their own account -- one key
# per deployment is the wrong shape, since Anthropic's key does not post to
# Stripe's board. Where we hold a key (a client whose roles we are filling), it
# is stored encrypted per employer:
#
#   juicebox ats-credential set --org <id> --vendor greenhouse \
#       --tenant <board-token> --key <key>
#
# Where we hold none -- the open market, i.e. most postings -- applications go
# through the employer's own hosted form in a browser, which is the same door a
# candidate uses. That needs no key at all.
