# Public front door. Caddy terminates TLS (automatic Let's Encrypt issuance
# and renewal, plus the HTTP->HTTPS redirect). Recruiter HTML is served by
# app.goforay.io; the FastAPI service is a distinct api.goforay.io origin.
{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	# Internal tool: accounts are provisioned by an admin, not open signup.
	# Blocked at the edge so a public visitor can't create an org.
	handle /v1/auth/signup {
		respond 403
	}
	handle {
		reverse_proxy web:80
	}
}

{$API_DOMAIN} {
	reverse_proxy api:8000
}
