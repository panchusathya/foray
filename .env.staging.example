# Staging environment for docker-compose.staging.yml.
# In the staging checkout:  cp .env.staging.example .env.staging  &&  chmod 600 .env.staging
#
# STAGING_SECRET_KEY is required (compose refuses to start without it) and MUST
# differ from prod SECRET_KEY. Reusing the prod key would let a staging leak
# mint valid production session tokens.
#
# Do not copy SMTP_*, MS_CLIENT_SECRET, or OUTREACH_* into this file. The
# compose file hard-wires EMAIL_PROVIDER=console and ignores them.

# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
STAGING_SECRET_KEY=

# Staging has its own Postgres container. These do not need to match prod
# (and should not — a matching password is a false sense of "same cluster").
STAGING_POSTGRES_PASSWORD=juicebox
STAGING_FORAY_DB_PASSWORD=foray

# Optional. Leave off unless you are rehearsing harvest/enrich/score against
# the staging database. These spend the same GitHub/OpenRouter/Apollo quotas
# as prod if you paste the prod keys.
# GITHUB_TOKEN=
# OPENROUTER_API_KEY=
# APOLLO_API_KEY=

# Model stays off in staging unless you are rehearsing an LLM code path.
JUICEBOX_LLM_ENABLED=false
# ANTHROPIC_API_KEY=

# Optional. Leave empty unless you are rehearsing jobs.scrape against staging.
# EXA_API_KEY=

EMBEDDING_PROVIDER=hashing
