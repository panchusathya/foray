# Production environment for docker-compose.prod.yml.
# On the VM:  cp .env.production.example .env  &&  chmod 600 .env  && edit.
# Values marked REQUIRED make `docker compose config` fail loudly if missing.

# ---- public identity (REQUIRED) --------------------------------------------
# Recruiter workspace origin.
APP_DOMAIN=app.goforay.io
# FastAPI origin. Point its A record at this VM before deploy.
API_DOMAIN=api.goforay.io
# Candidate experience origin. This is deployed independently from the
# OpenInstinct repository, not by this compose stack.
OPENINSTINCT_URL=https://apply.goforay.io
# Let's Encrypt sends certificate-expiry notices here.
ACME_EMAIL=sathya.panchu@westbridgecap.com

# ---- secrets (REQUIRED) -----------------------------------------------------
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating this later invalidates all sessions AND the tracking tokens in
# already-sent email — rotate deliberately.
SECRET_KEY=
# Any long random string; only the containers ever see it.
POSTGRES_PASSWORD=

# ---- outreach (REQUIRED to send) --------------------------------------------
EMAIL_PROVIDER=smtp
OUTREACH_FROM_EMAIL=
OUTREACH_FROM_NAME=
OUTREACH_DAILY_CAP=200
# Gap between two automated emails from one org, picked in [MIN, MAX] seconds (MIN=0 = no gap).
OUTREACH_SEND_SPACING_SECONDS=45
OUTREACH_SEND_SPACING_MAX_SECONDS=60
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# ---- model (optional — app works fully offline without it) ------------------
ANTHROPIC_API_KEY=
JUICEBOX_LLM_ENABLED=true

# ---- embeddings (NOT optional if you propose roles to candidates) ------------
# hashing = offline + deterministic. voyage = hosted, needs VOYAGE_API_KEY;
# after switching providers run:  docker compose -f docker-compose.prod.yml
#   exec api python -m juicebox.cli reembed
#
# "hashing" is a placeholder, not a cheap embedding: its cosines carry no
# meaning, so the vector term (0.30 of a 1.40 blend, see JOB_MATCH_*_WEIGHT) is
# noise. That is survivable for recruiter-side search, where the heuristic term
# reads a full CRM profile. It is not survivable for a candidate onboarded by
# text: their whole profile is a LinkedIn header -- no skills, no dated roles --
# so the heuristic term sits near 0.3 and the other two terms cannot carry them
# over PROPOSAL_SCORE_FLOOR. Measured on the 2026-08-25 thread: 0.44 on hashing,
# 0.58 on real embeddings, against a floor of 0.55.
# Default is now voyage. With no VOYAGE_API_KEY set, `get_embedder` falls back
# to hashing on its own, so flipping the default cannot break a deployment that
# has no key -- it only stops one that HAS a key from silently not using it.
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=

# The model for work someone is waiting on -- previews, personalisation. Left
# empty it falls back to JUICEBOX_LLM_MODEL, so only the timeout changes.
#
# Worth setting. Measured against production's reasoning model on the real
# personalisation prompt: z-ai/glm-5.2 took 74s and then returned non-JSON, so
# the call failed and the heuristic text was used anyway;
# google/gemini-2.5-flash-lite answered in 3.3s with valid output. Note that
# openai/gpt-4o-mini 404s here -- the JSON-schema request pins routing to
# providers that also accept a reasoning budget, and it is not one of them.
JUICEBOX_LLM_FAST_MODEL=
# How long a fast call may take before falling back to the deterministic text.
LLM_FAST_TIMEOUT_SECONDS=20

# ---- Outlook via Microsoft Graph (optional) ----------------------------------
# Redirect URI defaults to {BASE_URL}/v1/integrations/microsoft/callback and
# must match the Azure app registration.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=organizations
MS_REDIRECT_URI=

# ---- integrations: Zoho Mail ------------------------------------------------
# A "server-based" OAuth client from api-console.zoho.com. Leave empty to
# disable. Turn on Multi DC if any mailbox lives outside the accounts domain
# below; the callback then reports which data centre each mailbox belongs to.
# Redirect URI defaults to {BASE_URL}/v1/integrations/zoho/callback and must
# match the client exactly. Scopes needed: ZohoMail.accounts.READ,
# ZohoMail.messages.ALL, ZohoMail.folders.READ.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=
# The data centre the mailboxes live in: accounts.zoho.com / .eu / .in /
# .com.au / .jp / zohocloud.ca / .sa
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com


# ---- integrations: ContactOut (personal-email enrichment) --------------------
# Personal email addresses for LinkedIn-sourced candidates, keyed on the profile
# URL. Measured 7/10 personal addresses against Apollo's 1/10 on the same ten
# candidates; billed per address found, so a miss is free. API access is on
# ContactOut's Team/API plan. Leave empty to disable the provider.
CONTACTOUT_API_KEY=

# ---- foray sourcing engine ----------------------------------------------------
# Password for the dedicated `foray` Postgres role (see deploy/README.md for
# creating the role/database on an existing volume). Any long random string.
FORAY_DB_PASSWORD=
# GitHub PAT (classic, public_repo/read scope is enough) — used by the offline
# harvest/enrich pipeline, not the query path.
GITHUB_TOKEN=
# OpenRouter key for archetype scoring + query parsing (cheap open-weight
# models; override with FORAY_SCORING_MODEL / FORAY_PARSE_MODEL slugs).
OPENROUTER_API_KEY=

# ---- ingest (optional) --------------------------------------------------------
JUICEBOX_API_KEY=
INGEST_WEBHOOK_SECRET=

# ---- auto-apply (optional) ----------------------------------------------------
# Browser Use Cloud. Empty = public boards hand off. Also set
# APPLY_BROWSER_AGENT=true and APPLY_BROWSER_AGENT_ACK=true in compose/env
# before live apply drives a managed Chrome.
BROWSER_USE_API_KEY=

# ---- job matching / Exa (optional) --------------------------------------------
# Worker scrapes public job postings on a cadence. Empty = skip cleanly; the
# jobs database still works off Project sync and CSV import.
# After setting this, recreate api + worker so the containers pick it up:
#   docker compose -f docker-compose.prod.yml up -d --force-recreate api worker
EXA_API_KEY=

# --- Foray internal calls (server to server) ---------------------------------
# Foray's /internal/* routes spend money (ContactOut credits) and /foray/* is
# proxied to the browser with no authentication at all, so those routes are
# gated by a shared secret that only the api container holds. Leave it blank and
# the "Find emails" action reports itself unavailable rather than failing oddly.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
FORAY_INTERNAL_TOKEN=

# Shared HMAC key for short-lived JuiceBox ↔ OpenInstinct service calls.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
OPENINSTINCT_SHARED_SECRET=
