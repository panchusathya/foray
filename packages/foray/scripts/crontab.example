# Foray on the Docker deployment. The old per-tier wrappers (refresh_*.sh)
# assumed a host virtualenv and are dead here; the nightly orchestrator runs
# every tier as a phase inside a one-shot foray-jobs container instead.
#
# Install with: crontab -l | cat - packages/foray/scripts/crontab.example | crontab -
# (or paste these two lines into the host crontab). /var/log/foray must exist.
#
# Never point FORAY_COMPOSE_FILE at docker-compose.staging.yml from this crontab.
# Staging has its own one-shot `foray-jobs` profile for rehearsals; unattended
# nightly must keep targeting prod.

# Growth pipeline: harvest -> enrich -> derive -> embed -> emails -> score ->
# active_view, each time-boxed. One lock, one log, one refresh_runs trail.
0 23 * * *  /opt/juicebox/packages/foray/scripts/nightly.sh >> /var/log/foray/nightly.log 2>&1

# Volatile-field refresh over the active subset, weekly (NOT nightly: at 100k
# the active set makes one serial GraphQL call each and competes with enrich
# for the same token/quota).
0 12 * * 0  cd /opt/juicebox && docker compose -f docker-compose.prod.yml run --rm --no-deps -T \
            foray-jobs python -m foray.refresh.volatile >> /var/log/foray/volatile.log 2>&1
