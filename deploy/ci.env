# Dummy values so `docker compose config` and the staging smoke job can
# interpolate ${VAR:?} without real secrets. Not usable in production:
# APP_DOMAIN is a reserved invalid TLD, SECRET_KEY is an obvious placeholder
# that juicebox.config rejects when JUICEBOX_ENV=production, and nothing here
# is a live credential.
APP_DOMAIN=ci.example.invalid
# The candidate portal is served from its own host, and both compose files
# interpolate it as ${PORTAL_DOMAIN:?}. It arrived with the portal SPA and this
# file was never given a value, so `compose files` has failed on every branch
# since -- including main.
PORTAL_DOMAIN=apply.ci.example.invalid
ACME_EMAIL=ci@example.invalid
SECRET_KEY=ci-not-a-real-secret-key-do-not-use-32
STAGING_SECRET_KEY=ci-staging-secret-key-do-not-use-32chars
POSTGRES_PASSWORD=ci-postgres
FORAY_DB_PASSWORD=ci-foray
STAGING_POSTGRES_PASSWORD=ci-postgres
STAGING_FORAY_DB_PASSWORD=ci-foray
OUTREACH_FROM_EMAIL=ci@example.invalid
JUICEBOX_LLM_ENABLED=false
EMAIL_PROVIDER=console
EMBEDDING_PROVIDER=hashing
