# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
build/
dist/

# node
node_modules/
packages/web/dist/
packages/web/public/juicebox-intake-widget.js
npm-debug.log*

# playwright: traces and screenshots of test runs, regenerated every run
packages/web/test-results/
packages/web/playwright-report/

# data + secrets
.env
.env.local
.env.staging
# Operator backups of the live .env, made in place on the prod VM before an
# edit (.env.bak-<date>, .env.bak.<epoch>). They sit in the deploy checkout at
# /opt/juicebox, so without this a single `git add -A` on the VM commits a
# full set of production secrets -- and gitleaks in CI would not catch it,
# because the leak arrives as a new file nobody reviewed. Ignore the shape,
# not the three that exist today.
.env.bak*
.env.*.bak
.env.save
data/*.db
data/*.db-wal
data/*.db-shm
eval/report*.json

# foray: never commit raw candidate exports or anything with personal emails
data/out/
*.csv
packages/foray/data/out/

# purchased datasets (Bright Data LinkedIn export, etc.). Real people's personal
# data, gigabytes of it — inputs live under data/ and must never reach a remote.
data/in/
data/*.json
data/*.jsonl
data/snap_*
*.jsonl
*.json.gz
# ...except the synthetic demo corpus, which is generated and belongs in git.
!data/seed/*.jsonl

# editors / os
.DS_Store
.idea/
.vscode/
.claude/launch.json
