# Copy to .env and edit. Every value below has a working default — the stack
# boots with no .env at all, on SQLite, with no model calls.

# ---- app ------------------------------------------------------------------
# Setting this to `production` makes the app refuse to start unless SECRET_KEY
# is a real value of at least 32 characters.
JUICEBOX_ENV=development
BASE_URL=http://localhost:8000
# Generate for production:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me-in-production
ACCESS_TOKEN_TTL_SECONDS=43200
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- storage --------------------------------------------------------------
# SQLite (default, zero setup):
# DATABASE_URL=sqlite:///./data/juicebox.db
# PostgreSQL (docker compose):
# DATABASE_URL=postgresql+psycopg://juicebox:juicebox@localhost:5432/juicebox

# ---- model ----------------------------------------------------------------
# Without a key the product still works end to end: the heuristic parser,
# deterministic scoring and template personalisation all run offline.
ANTHROPIC_API_KEY=
JUICEBOX_LLM_ENABLED=true
JUICEBOX_LLM_MODEL=claude-opus-5
LLM_MAX_CONCURRENCY=8
# Retries apply to 429s and 5xx only; refusals and bad JSON are not retried.
LLM_MAX_RETRIES=2
LLM_RETRY_INITIAL_DELAY=0.5
LLM_RETRY_MAX_DELAY=8.0

# ---- embeddings -----------------------------------------------------------
# hashing = offline + deterministic. voyage = hosted, needs VOYAGE_API_KEY.
EMBEDDING_PROVIDER=hashing
EMBEDDING_DIM=512
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3
# auto = postgres FTS+pgvector when DATABASE_URL is postgres, else in-process.
# memory forces the RAM index even on postgres (debugging / parity checks).
RETRIEVAL_BACKEND=auto

# ---- retrieval tuning -----------------------------------------------------
RETRIEVAL_CANDIDATE_POOL=200
RERANK_TOP_K=20
RRF_K=60
# Blend of the three signals in the final score (normalised automatically).
HEURISTIC_WEIGHT=0.55
RETRIEVAL_WEIGHT=0.20
RERANK_WEIGHT=0.25

# ---- outreach -------------------------------------------------------------
# console | smtp | memory
EMAIL_PROVIDER=console
OUTREACH_FROM_EMAIL=recruiting@example.com
OUTREACH_FROM_NAME=Talent Team
OUTREACH_DAILY_CAP=200
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# ---- integrations: Outlook via Microsoft Graph ------------------------------
# Azure app registration (single-tenant). Leave empty to disable the feature.
# Redirect URI defaults to {BASE_URL}/v1/integrations/microsoft/callback and
# must match the URI registered on the Azure app.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=organizations
MS_REDIRECT_URI=
# How often the worker checks connected inboxes for candidate replies.
MAILBOX_SYNC_SECONDS=120

# ---- worker ---------------------------------------------------------------
WORKER_TICK_SECONDS=60
WORKER_POLL_SECONDS=2
WORKER_BATCH_SIZE=20
WORKER_LOCK_TIMEOUT_SECONDS=900
WORKER_MAX_ATTEMPTS=5

# ---- ingestion worker -----------------------------------------------------
JUICEBOX_API_URL=http://localhost:8000
JUICEBOX_API_KEY=
INGEST_BATCH_SIZE=200
INGEST_CONCURRENCY=3
INGEST_WEBHOOK_PORT=8787
INGEST_WEBHOOK_SECRET=
GITHUB_TOKEN=

# ---- foray sourcing engine (packages/foray) -------------------------------
# Foray shares this .env but namespaces its DB URL so it never clobbers the
# Juicebox DATABASE_URL above. Points at the `foray` database created inside the
# shared pgvector Postgres container (see docker-compose.yml + packages/foray).
FORAY_DATABASE_URL=postgresql://foray:foray@localhost:5432/foray
# GITHUB_TOKEN (above) is reused by Foray for harvest + enrichment (classic PAT,
# no scopes needed for public data). ANTHROPIC_API_KEY (above) powers scoring.
# Apollo is Phase 6 only; leave blank until then. Use a personal account.
APOLLO_API_KEY=
# Optional overrides (all have working defaults):
# FORAY_SCORING_MODEL=claude-haiku-4-5-20251001
# FORAY_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# FORAY_SCORE_WEIGHT=0.7
# FORAY_VECTOR_WEIGHT=0.3
